{
  "manifest_version": 3,
  "name": "OpenLinks — поставщики",
  "version": "0.13.0",
  "description": "Мониторинг чатов поставщиков, Claude и OpenAI API, ручные промпты TXT и черновики без отправки.",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "debugger",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.alibaba.com/*",
    "https://*.made-in-china.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть OpenLinks"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.1688.com/*",
        "https://*.alibaba.com/*",
        "https://*.made-in-china.com/*"
      ],
      "js": [
        "rules-shared.js",
        "routes-1688-shared.js",
        "supplier-chat.js",
        "content.js",
        "dialogs-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "minimum_chrome_version": "120"
}
